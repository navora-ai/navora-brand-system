{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "NAVORA Design System — Typography Tokens v1.2",
  "typography": {
    "display": {
      "xl": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Newsreader",
          "fontWeight": 500,
          "fontSize": "64px",
          "lineHeight": "72px",
          "letterSpacing": "-1.2px"
        }
      },
      "l": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Newsreader",
          "fontWeight": 500,
          "fontSize": "48px",
          "lineHeight": "56px",
          "letterSpacing": "-0.6px"
        }
      }
    },
    "heading": {
      "h1": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Newsreader",
          "fontWeight": 500,
          "fontSize": "40px",
          "lineHeight": "48px",
          "letterSpacing": "-0.4px"
        }
      },
      "h2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Newsreader",
          "fontWeight": 500,
          "fontSize": "32px",
          "lineHeight": "40px",
          "letterSpacing": "-0.2px"
        }
      },
      "h3": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Newsreader",
          "fontWeight": 500,
          "fontSize": "24px",
          "lineHeight": "32px",
          "letterSpacing": "0"
        }
      }
    },
    "body": {
      "l": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 400,
          "fontSize": "18px",
          "lineHeight": "28px",
          "letterSpacing": "0"
        }
      },
      "m": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 400,
          "fontSize": "16px",
          "lineHeight": "24px",
          "letterSpacing": "0"
        }
      },
      "s": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 400,
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0"
        }
      }
    },
    "label": {
      "l": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 600,
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0.6px"
        }
      },
      "m": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 600,
          "fontSize": "12px",
          "lineHeight": "16px",
          "letterSpacing": "0.8px"
        }
      },
      "s": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 500,
          "fontSize": "11px",
          "lineHeight": "14px",
          "letterSpacing": "1.1px"
        }
      }
    },
    "data": {
      "m": {
        "$type": "typography",
        "$value": {
          "fontFamily": "IBM Plex Mono",
          "fontWeight": 400,
          "fontSize": "13px",
          "lineHeight": "18px",
          "letterSpacing": "0"
        }
      },
      "s": {
        "$type": "typography",
        "$value": {
          "fontFamily": "IBM Plex Mono",
          "fontWeight": 400,
          "fontSize": "11px",
          "lineHeight": "16px",
          "letterSpacing": "0"
        }
      }
    }
  },
  "fontFamilies": {
    "display": "Newsreader",
    "body": "Inter",
    "data": "IBM Plex Mono"
  },
  "fontSources": {
    "newsreader": "https://fonts.google.com/specimen/Newsreader",
    "inter": "https://rsms.me/inter/",
    "ibm-plex-mono": "https://fonts.google.com/specimen/IBM+Plex+Mono"
  }
}
